# Meta Instagram Graph API
INSTAGRAM_USER_ID=your_instagram_business_account_id
META_GRAPH_ACCESS_TOKEN=your_long_lived_user_access_token
META_GRAPH_API_VERSION=v21.0

# AI Providers (Hooks, 3-Paragraph Viral Captions & Research Synthesis)
# Option A: Groq Cloud (Recommended Free Tier - Ultra-fast LPU inference, Llama 3.3 70B & Llama 3.1 8B)
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key

# Option B: Google Gemini
GEMINI_API_KEY=your_gemini_api_key

# Option C: OpenAI / xAI Grok / Anthropic Claude / Ollama
OPENAI_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_API_KEY=ollama

# Video Storage (Publicly reachable URL required by Meta Graph API)
# Options: "local_tunnel" (ngrok/localtunnel) or "r2_s3" (Cloudflare R2 / AWS S3)
STORAGE_PROVIDER=local_tunnel
PUBLIC_BASE_URL=https://your-public-storage.com

# Optional Cloudflare R2 / AWS S3 Credentials (if STORAGE_PROVIDER=r2_s3)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Optional Telegram Review Bot (For 1-click Approve/Reject before posting)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Default Channel Profile
DEFAULT_CHANNEL=quantum
